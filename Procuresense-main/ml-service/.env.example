# ML Service Environment Variables
# Copy this file to .env for local development

# Server
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Database (shared with backend)
DATABASE_URL=postgresql://user:password@localhost:5432/procuresense_db

# Security
API_KEY=your_internal_api_key_for_ml_service
ALLOWED_ORIGINS=http://localhost:5000,https://procuresense-backend.onrender.com

# Model paths
MODEL_DIR=trained_models

# Logging
LOG_LEVEL=info
